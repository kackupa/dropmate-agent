DATABASE_PATH=./data/darkdrop-agents.sqlite
MAX_SINGLE_PAYMENT_SOL=0.25
DAILY_LIMIT_SOL=2
APPROVAL_REQUIRED_ABOVE_SOL=0.1
FRONTEND_FEE_BPS=10
FRONTEND_FEE_CAP_USD=1
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DARKDROP_RELAYER_URL=
DARKDROP_PROGRAM_ID=

# Real DarkDrop agent safety controls.
DARKDROP_ENABLED=true
DARKDROP_MAX_DROP_SOL=0.05
DARKDROP_DAILY_LIMIT_SOL=0.25
DARKDROP_AGENT_PORT=8790
DARKDROP_RELAYER_FEE_BPS=50
AGENT_KEYPAIR_PATH=./data/agent-a-devnet.json
AGENT_B_KEYPAIR_PATH=./data/agent-b-devnet.json

# DropMate Agent API hardening.
# If set, HTTP POST/metadata endpoints require x-api-key or Bearer auth.
DROPMATE_API_KEY=

# Simple in-memory HTTP rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
